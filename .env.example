QUANTFORGE_ENVIRONMENT=development
# Use your existing PostgreSQL server here.
# Format:
# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
QUANTFORGE_DATABASE_URL=postgresql+psycopg://quantforge:quantforge@localhost:5432/quantforge
QUANTFORGE_REDIS_URL=redis://localhost:6379/0
QUANTFORGE_PARQUET_CACHE_DIR=./var/parquet
QUANTFORGE_CANDLE_SOURCE=coreui

# CoreUI's OANDA history database is the current live candle source.
# Use the same value as CoreUI_backend\.env HISTORY_DATABASE_URL.
QUANTFORGE_COREUI_HISTORY_DATABASE_URL=
QUANTFORGE_COREUI_CANDLE_TABLE=oanda_candles

QUANTFORGE_OANDA_API_URL=https://api-fxpractice.oanda.com/v3
QUANTFORGE_OANDA_ACCOUNT_ID=
QUANTFORGE_OANDA_API_TOKEN=
