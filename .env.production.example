QUANTFORGE_ENVIRONMENT=production
QUANTFORGE_DATABASE_URL=postgresql+psycopg://quantforge:CHANGE_ME@postgres:5432/quantforge
QUANTFORGE_REDIS_URL=redis://redis:6379/0
QUANTFORGE_PARQUET_CACHE_DIR=/app/var/parquet
QUANTFORGE_CANDLE_SOURCE=coreui

# Set this to the production CoreUI history database URL.
QUANTFORGE_COREUI_HISTORY_DATABASE_URL=
QUANTFORGE_COREUI_CANDLE_TABLE=oanda_candles

# Optional external integrations. Keep secrets only in the real .env.production file.
QUANTFORGE_OANDA_API_URL=https://api-fxpractice.oanda.com/v3
QUANTFORGE_OANDA_ACCOUNT_ID=
QUANTFORGE_OANDA_API_TOKEN=
QUANTFORGE_MONDAY_API_URL=https://api.monday.com/v2
QUANTFORGE_MONDAY_API_TOKEN=
QUANTFORGE_MONDAY_BOARD_ID=

QUANTFORGE_DASHBOARD_API_HOST=0.0.0.0
QUANTFORGE_DASHBOARD_API_PORT=8000
QUANTFORGE_DASHBOARD_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://192.168.1.113:5174

POSTGRES_DB=quantforge
POSTGRES_USER=quantforge
POSTGRES_PASSWORD=CHANGE_ME
